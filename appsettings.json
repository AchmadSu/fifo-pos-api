{
  "ConnectionStrings": {
    "DefaultConnection": "#{DEFAULT_CONNECTION}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FMPKey": "#{FMP_KEY}#",
  "JWT": {
    "Issuer": "#{JWT_ISSUER}#",
    "Audience": "#{JWT_AUDIENCE}#",
    "SigningKey": "#{JWT_SIGNING_KEY}#"
  }
}
